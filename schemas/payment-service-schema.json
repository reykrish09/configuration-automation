{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "application": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "enum": ["dev", "qa", "prod"]
        }
      },
      "required": ["name", "environment"]
    },

    "server": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ssl_enabled": {
          "type": "boolean"
        }
      },
      "required": ["port", "ssl_enabled"]
    },

    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR"]
        }
      },
      "required": ["level"]
    },

    "database": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      },
      "required": ["host", "port"]
    },

    "performance": {
      "type": "object",
      "properties": {
        "max_connections": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["max_connections"]
    }
  },

  "required": [
    "application",
    "server",
    "logging",
    "database",
    "performance"
  ]
}